// Expands the list of available conditions for contingency spells
// TODO: make UI patching compatible with popular UI mods

// Expanding tables
// contingency conditions
ACTION_DEFINE_ASSOCIATIVE_ARRAY contcond_array BEGIN
  // condition id, tra label, tra desc, symbolic name
  8, 2500, 2501, ~ATTACKED~ => 1    // AttackedBy([ANYONE])
  9, 2502, 2503, ~RANGE4~ => 1      // PersonalSpaceDistance([ANYONE],4)
  10, 2504, 2505, ~RANGE10~ => 1    // PersonalSpaceDistance([ANYONE],10)
  11, 2506, 2507, ~DELAY~ => 1      // Delay(0) -> crashes the game
  12, 2508, 2509, ~TOOKDAMAGE~ => 1 // TookDamage()
  13, 2510, 2511, ~KILLED~ => 1     // Killed([ANYONE])
  14, 2512, 2513, ~TIMEOFDAY~ => 1  // TimeOfDay(0)
  15, 2514, 2515, ~RANGEX~ => 1     // PersonalSpaceDistance([ANYONE],0)
  16, 2514, 2515, ~STATEX~ => 1     // StateCheck([ANYONE],0)
  17, 2516, 2517, ~DIE~ => 1        // Die()
  18, 2518, 2519, ~DIED~ => 1       // Died([ANYONE])
END

ACTION_PHP_EACH contcond_array AS data => _ BEGIN
  OUTER_SET index = $data(~0~)
  OUTER_SET tra_name = $data(~1~)
  OUTER_SET tra_name = RESOLVE_STR_REF((AT "tra_name"))
  OUTER_SET tra_desc = $data(~2~)
  OUTER_SET tra_desc = RESOLVE_STR_REF((AT "tra_desc"))
  OUTER_SPRINT label $data(~3~)
  APPEND ~contcond.2da~ ~%index% %tra_name% %tra_desc% %label%~ UNLESS ~^%index%[ %TAB%]+[0-9]+~
END

COPY_EXISTING ~contcond.2da~ ~override~
  PRETTY_PRINT_2DA
BUT_ONLY

/*
// contingency targets
OUTER_SET tra_name = RESOLVE_STR_REF(@2550)
OUTER_SET tra_desc = RESOLVE_STR_REF(@2551)
APPEND ~conttarg.2da~ ~4 %tra_name% %tra_desc% NEAREST~ UNLESS ~^4[ %TAB%]+[0-9]+~
COPY_EXISTING ~conttarg.2da~ ~override~
