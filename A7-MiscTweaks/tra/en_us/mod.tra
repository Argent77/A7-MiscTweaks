// use tra indices 2000 or higher

// Item description strings for "Equipment with critical hit protection"
// Specify empty strings to skip item description update
// Search strings as regular expressions
@2000 = ~STATISTICS:~
@2001 = ~Equipped abilities:~
// replacement strings
@2010 = ~STATISTICS:~
@2011 = ~Equipped abilities:~
// new string
@2020 = ~– Protects against critical hits~

// Lines for automatic TotLM transition
@2100 = ~Several days later...~

// Lines for "Great Oak's Beacon" ability
@2200 = ~Great Oak's Beacon~
@2201 = ~Great Oak's Beacon
Kuldahar's Great Oak lends you the power to return to Kuldahar for 8 hours from any place in Icewind Dale. When 8 hours have passed the party is automatically brought back to where the journey began.~
@2202 = ~Return Home~
@2203 = ~Return Home
With this ability you can instantly return to the place where the journey began without having to wait for the enchantment of the beacon to bring you back.~

@2210 = ~The Great Oak grants you the blessing of nature.~
@2211 = ~The evil of this place suppresses the powers of the Great Oak.~
@2212 = ~The spell doesn't appear to work in this place.~
@2213 = ~Beacon~

// Lines for launcher weapon tweaks
// Full damage definition string
// %sign% is a placeholder for the positive or negative sign of the damage value
// %damage% is a placeholder for the actual damage value
@2300 = ~Damage: %sign%%damage% (missile)~
// Short damage definition string (without additional specifiers)
@2301 = ~Damage: %sign%%damage%~
// sign for positive damage modifier
@2305 = ~+~
// sign for negative damage modifier
@2306 = ~-~
// one or more regular expressions to match the damage modifier
@2310 = ~Damage: [-+]?[0-9]+~
// one or more regular expressions to match the line right before the damage modifier
@2320 = ~THAC0: [-+]?[0-9]+~
// one or more regular expressions to match the line right after the damage modifier
@2330 = ~Speed Factor: [0-9]+~

// Map note
@2400 = ~Safe Chest~
