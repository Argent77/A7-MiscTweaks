// use tra indices 2000 or higher

// Item description strings for "Equipment with critical hit protection"
// Specify empty strings to skip item description update
// Search strings as regular expressions
@2000 = ~\(EIGENSCHAFTEN\|STATISTIK\|STATISTIKEN\):~
@2001 = ~Ausgerüstete Fähigkeit\(en\)?:?~
// replacement strings
@2010 = ~EIGENSCHAFTEN:~
@2011 = ~Ausgerüstete Fähigkeiten:~
// new string
@2020 = ~– Schützt vor kritischen Treffern~

// Lines for automatic TotLM transition
@2100 = ~Einige Tage später...~

// Lines for "Great Oak's Beacon" ability
@2200 = ~Leuchtfeuer der Großen Eiche~
@2201 = ~Leuchtfeuer der Großen Eiche
Kuldahars Große Eiche gewährt Euch die Fähigkeit, von jedem Ort im Eiswindtal aus für 8 Stunden nach Kuldahar zurückzukehren. Wenn die Zeit abgelaufen ist, dann kehrt die Gruppe automatisch zu ihrem Ursprungsort zurück.~
@2202 = ~Nach Hause zurückkehren~
@2203 = ~Nach Hause zurückkehren
Mit dieser Fähigkeit kann die Gruppe sofort zu ihrem Ursprungsort zurückzukehren, ohne darauf warten zu müssen, dass sie die Verzauberung des Leuchtfeuers zurückbringt.~

@2210 = ~Die Große Eiche gewährt Euch ihren Segen der Natur.~
@2211 = ~Das Böse an diesem Ort unterdrückt die Macht der Großen Eiche.~
@2212 = ~Der Zauber scheint an diesem Ort nicht zu funktionieren.~
@2213 = ~Leuchtfeuer~

// Lines for launcher weapon tweaks
// Full damage definition string
// %sign% is a placeholder for the positive or negative sign of the damage value
// %damage% is a placeholder for the actual damage value
@2300 = ~Schadensbonus: %sign%%damage% (Geschoss)~
// Short damage definition string (without additional specifiers)
@2301 = ~Schadensbonus: %sign%%damage%~
// sign for positive damage modifier
@2305 = ~+~
// sign for negative damage modifier
@2306 = ~-~
// one or more regular expressions to match the damage modifier
@2310 = ~Schadensbonus: [-+]?[0-9]+~
// one or more regular expressions to match the line right before the damage modifier
@2320 = ~ETW0-Bonus: [-+]?[0-9]+~
// one or more regular expressions to match the line right after the damage modifier
@2330 = ~Initiativefaktor: [0-9]+~
