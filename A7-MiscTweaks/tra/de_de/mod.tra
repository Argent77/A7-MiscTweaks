@2510 = ~Wesen getötet~
@2511 = ~Wenn der Zaubernde ein Wesen getötet hat.~
@2512 = ~Tagsüber~
@2513 = ~Wird tagsüber ausgelöst.~
@2514 = ~(Unbrauchbar)~
