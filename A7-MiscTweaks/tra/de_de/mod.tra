@2500 = ~Angriff~
@2501 = ~Wenn ein Wesen den Zaubernden angreift.~
@2502 = ~1,2 Meter Reichweite~
@2503 = ~Wenn sich ein Wesen innerhalb 1,2 Meter Reichweite des Zaubernden befindet.~
@2504 = ~3 Meter Reichweite~
@2505 = ~Wenn sich ein Wesen innerhalb 3 Meter Reichweite des Zaubernden befindet.~
